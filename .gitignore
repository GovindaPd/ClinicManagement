# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Django stuff:
*.log
*.pot
*.pyc
*.pyo
*.pyd

# Database files
*.sqlite3
db.sqlite3

# Media / uploaded files
/media
/media/*


# Static files (if you're collecting static here)
/static
/static/*

#migration files
/migrations/*
*/migrations/__pycache__/

# Local settings (optional, if you separate secrets)
.env
.env.*

# VS Code / PyCharm / other IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files or macos specific files
.DS_Store
Thumbs.db

# Pip environment files
*.egg-info/
.eggs/
*.egg
pip-log.txt

# Virtual environments
venv/
env/
ENV/
.venv/